# Public base URL of the backend API (browser + server)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Public URL of this frontend (used for metadata / share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SocialScope
# Optional: server-side base URL if the API is reachable on a private network (defaults to NEXT_PUBLIC_API_URL)
API_INTERNAL_URL=

# Legal pages (Privacy / Terms / Data Deletion) — fill in before platform review
NEXT_PUBLIC_LEGAL_COMPANY=SocialScope
NEXT_PUBLIC_LEGAL_ADDRESS=Office address, Lahore, Punjab, Pakistan
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@socialscope.co
NEXT_PUBLIC_SUPPORT_EMAIL=support@socialscope.co
NEXT_PUBLIC_LEGAL_COURTS=the courts of Lahore, Pakistan
